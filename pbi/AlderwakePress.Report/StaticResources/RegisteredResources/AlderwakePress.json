{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.149.json",
  "name": "Alderwake Press",
  "dataColors": [
    "#0156F5",
    "#001F37",
    "#39B8FF",
    "#99BBFB",
    "#FF2215",
    "#FF9C9C"
  ],
  "good": "#14845A",
  "neutral": "#E39B00",
  "bad": "#FF2215",
  "foreground": "#001F37",
  "foregroundNeutralSecondary": "#425B76",
  "background": "#FFFFFF",
  "backgroundLight": "#E5EEFE",
  "backgroundNeutral": "#CCDDFC",
  "tableAccent": "#0156F5",
  "textClasses": {
    "title": {
      "fontFace": "Century Gothic",
      "fontSize": 15,
      "color": "#001F37"
    },
    "header": {
      "fontFace": "Century Gothic",
      "fontSize": 12,
      "color": "#001F37"
    },
    "label": {
      "fontFace": "Century Gothic",
      "fontSize": 11,
      "color": "#425B76"
    },
    "callout": {
      "fontFace": "Century Gothic",
      "fontSize": 40,
      "color": "#001F37"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#E5EEFE"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "title": [
          {
            "fontFamily": "Century Gothic",
            "fontSize": 15,
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#001F37"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#CCDDFC"
              }
            },
            "radius": 14
          }
        ],
        "padding": [
          {
            "top": 16,
            "bottom": 16,
            "left": 18,
            "right": 18
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "legend": [
          {
            "position": "TopRight",
            "fontFamily": "Century Gothic",
            "fontSize": 11
          }
        ],
        "categoryAxis": [
          {
            "fontFamily": "Century Gothic",
            "labelColor": {
              "solid": {
                "color": "#425B76"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "fontFamily": "Century Gothic",
            "labelColor": {
              "solid": {
                "color": "#425B76"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#E5EEFE"
              }
            }
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "$id": "default",
            "fontFamily": "Century Gothic",
            "fontSize": 40,
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#001F37"
              }
            }
          }
        ],
        "label": [
          {
            "$id": "default",
            "fontFamily": "Century Gothic",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#0156F5"
              }
            }
          }
        ]
      }
    }
  }
}
